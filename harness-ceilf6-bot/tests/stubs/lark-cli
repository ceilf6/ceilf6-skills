#!/usr/bin/env bash
# 假 lark-cli：把完整 argv 记到 ${STUB_LOG}，按首个子命令输出录制响应。
# STUB_FAIL_FIRST=1 时首次调用失败（测重试）。
# STUB_SLOW_IM_S=<秒> 让私信调用挂住指定时长（日志行在挂起前已写下），用来把「控制面动作
# 卡在飞书往返里」的窗口撑到可观测。
set -euo pipefail
log="${STUB_LOG:?需要 STUB_LOG}"
printf '%s\n' "$*" >> "$log"
count_file="${log}.count"
prev=0
[ -f "$count_file" ] && prev=$(cat "$count_file")
calls=$((prev + 1))
echo "$calls" > "$count_file"
if [ "${STUB_FAIL_FIRST:-0}" = "1" ] && [ "$calls" -eq 1 ]; then
  echo '{"ok":false,"error":"stub 注入的首次失败"}' >&2
  exit 1
fi
# STUB_SLOW_IM_MATCH=<子串>：只让内容含该子串的私信挂住，其余照常。要观测「某一条回执还在
# 途中」的窗口时必须能这样点名——一律挂住会把窗口里用来做判据的 /tasks、/stop 回执一起拖住。
if [ -n "${STUB_SLOW_IM_S:-}" ] && [ "$1" = "im" ]; then
  case "${STUB_SLOW_IM_MATCH:-}" in
    "") sleep "$STUB_SLOW_IM_S" ;;
    *) case "$*" in *"$STUB_SLOW_IM_MATCH"*) sleep "$STUB_SLOW_IM_S" ;; esac ;;
  esac
fi
# STUB_SLOW_API_S=<秒>：表情调用（api）挂住指定时长，用来把「任务已收下、状态表情还没回来」
# 的启动窗口撑到可观测。日志行同样在挂起前已写下，调用方据此知道自己已进入窗口。
if [ -n "${STUB_SLOW_API_S:-}" ] && [ "$1" = "api" ]; then
  sleep "$STUB_SLOW_API_S"
fi
if [ "$1" = "event" ] && [ "${2:-}" = "consume" ]; then
  echo "[event] ready event_key=im.message.receive_v1" >&2
  [ -n "${STUB_EVENTS_FILE:-}" ] && cat "$STUB_EVENTS_FILE"
  # 模拟长连接：stdin 不关则挂住（listener 用 stdin 保活）
  cat > /dev/null
  exit 0
fi
case "$1" in
  api)
    case "$*" in
      *DELETE*) echo '{"ok":true,"data":{}}' ;;
      *) echo '{"ok":true,"data":{"reaction_id":"rid_123"}}' ;;
    esac ;;
  im) echo "{\"ok\":true,\"data\":{\"message_id\":\"om_send_${calls}\",\"thread_id\":\"omt_send_${calls}\"}}" ;;
  *) echo '{"ok":true,"data":{}}' ;;
esac
