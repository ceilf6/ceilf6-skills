#!/usr/bin/env node
// 假 claude（stream-json 长驻协议）：启动即发 init 事件；每收到一条 user 消息按 STUB_TURNS
// 第 N 条指令回一个 result 事件（超出用最后一条）；stdin 关闭即退出。
// hang 指令不回 result（进程仍活着），用于触发每轮超时；die 指令收到消息即退出 1
// 且不回 result，用于活跃轮次进程死亡分支。ask 的参数以 | 分隔 question 与 summary。
// STUB_SELF_TURN（{"afterMs":N,"directive":"…"}）：回完一轮后无需输入自发再出一轮 result，
// 模拟会话自布后台任务完成触发的自唤醒轮，只触发一次。STUB_VERDICT 是单指令旧名。
import { appendFileSync, openSync, writeFileSync } from 'node:fs';
import { spawn } from 'node:child_process';
import { createInterface } from 'node:readline';

// STUB_IGNORE_SIGTERM：装一个空 SIGTERM 处理器后照常挂着，模拟组内捕获 SIGTERM 却不退的
// 子进程（机审、测试 runner、pre-commit 钩子），用于验证宽限期后的 SIGKILL 升级。
if (process.env.STUB_IGNORE_SIGTERM) process.on('SIGTERM', () => {});

// STUB_GRANDCHILD=<心跳文件>：起一个留在同一进程组、忽略 SIGTERM、stdio 重定向到文件的孙进程
// （后台化的机审 / 测试 runner / pre-commit 钩子的形态），每 200ms 往心跳文件追加一个字节，pid 记在
// <心跳文件>.pid。它不占着会话管道，故本进程一退 close 立刻到达；只有真发出的 SIGKILL 能让它消失。
// 30s 保险丝：用例失败时不至于把它留在机器上。
if (process.env.STUB_GRANDCHILD) {
  const beat = process.env.STUB_GRANDCHILD;
  const out = openSync(`${beat}.out`, 'a');
  const gc = spawn(process.execPath, ['-e', `
    process.on('SIGTERM', () => {});
    const { appendFileSync } = require('node:fs');
    setInterval(() => appendFileSync(process.argv[1], 'x'), 200);
    setTimeout(() => process.exit(0), 30000);
  `, beat], { stdio: ['ignore', out, out] });
  writeFileSync(`${beat}.pid`, String(gc.pid));
  gc.unref();
}

const args = process.argv.slice(2);
if (process.env.STUB_ARGS_OUT) writeFileSync(process.env.STUB_ARGS_OUT, args.join('\n') + '\n');
const turns = (process.env.STUB_TURNS ?? process.env.STUB_VERDICT ?? 'pass').split(';');
const SESSION = process.env.STUB_SESSION_ID ?? 'sess_stub_1';
// STUB_SPLIT_MULTIBYTE：把事件行在首个多字节 UTF-8 字符中间劈成两个先后到达的 chunk，
// 供消费方验证跨 chunk 的字节缓冲解码（无多字节字符的行不劈）。
const emit = (o) => {
  const line = Buffer.from(JSON.stringify(o) + '\n');
  const hi = line.findIndex((b) => b >= 0x80);
  if (process.env.STUB_SPLIT_MULTIBYTE && hi >= 0) {
    process.stdout.write(line.subarray(0, hi + 1));
    setTimeout(() => process.stdout.write(line.subarray(hi + 1)), 30);
    return;
  }
  process.stdout.write(line);
};

function resultLineFor(kind, arg) {
  if (kind === 'ask' || kind === 'working') {
    const [q, s] = arg.split('|');
    const obj = kind === 'ask' ? { verdict: 'ask', question: q || '缺信息' } : { verdict: 'working' };
    if (kind === 'working' && q) obj.reason = q;
    if (s) obj.summary = s;
    return 'RESULT ' + JSON.stringify(obj);
  }
  return {
    pass: 'RESULT {"verdict":"pass","branch":"b","mr_url":"https://mr/9","summary":"完成"}',
    skip: 'RESULT {"verdict":"skip","reason":"闲聊"}',
    fail: 'RESULT {"verdict":"fail","reason":"跑挂了"}',
    escalate: 'RESULT {"verdict":"escalate","reason":"需求不明确"}',
    fused: 'RESULT {"verdict":"fused","reason":"CR 熔断"}',
    noresult: '没有结果行',
    garbage: '没有结果行',
  }[kind] ?? `RESULT {"verdict":"${kind}"}`;
}

function emitTurn(directive) {
  const [kind, ...rest] = directive.split(':');
  const arg = rest.join(':');
  if (kind === 'hang') return;
  if (kind === 'die') process.exit(1);
  if (kind === 'error') { emit({ type: 'result', is_error: true, result: arg || '假 API 错误', session_id: SESSION }); return; }
  emit({ type: 'result', is_error: false, result: `过程输出\n${resultLineFor(kind, arg)}`, session_id: SESSION });
}

let n = 0;
let selfArmed = !!process.env.STUB_SELF_TURN;
emit({ type: 'system', subtype: 'init', session_id: SESSION });
createInterface({ input: process.stdin }).on('line', (line) => {
  let msg;
  try { msg = JSON.parse(line); } catch { return; }
  const content = String(msg?.message?.content ?? '');
  if (n === 0 && process.env.STUB_PROMPT_OUT) writeFileSync(process.env.STUB_PROMPT_OUT, content);
  if (process.env.STUB_MSGS_OUT) appendFileSync(process.env.STUB_MSGS_OUT, content.replaceAll('\n', '⏎') + '\n');
  const directive = turns[Math.min(n, turns.length - 1)];
  n++;
  emitTurn(directive);
  if (selfArmed) {
    selfArmed = false;
    const cfg = JSON.parse(process.env.STUB_SELF_TURN);
    setTimeout(() => emitTurn(cfg.directive), cfg.afterMs);
  }
});
process.stdin.on('end', () => process.exit(0));
